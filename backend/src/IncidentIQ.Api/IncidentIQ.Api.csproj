<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    <UserSecretsId>incidentiq-api-8aa42e48-c83c-455a-8c6d-f228e96bc7ed</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove=".local\**" />
    <None Remove=".local\**" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Include="..\..\data\synthetic\*.md;..\..\data\synthetic\*.jsonl" Link="data\synthetic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Properties\launchSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Property\" />
  </ItemGroup>

</Project>
